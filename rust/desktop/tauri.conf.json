{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindcraft",
  "version": "0.1.0",
  "identifier": "com.mindcraft.minecraft",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "title": "Mindcraft",
        "width": 1120,
        "height": 780,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Game",
    "shortDescription": "Your native Rust AI Minecraft teammate",
    "resources": {
      "binaries/mindcraft": "mindcraft"
    }
  }
}
