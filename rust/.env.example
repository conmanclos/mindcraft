# Minecraft connection (host or host:port; the pinned Azalea parser does not support IPv6 literals)
MINDCRAFT_MC_SERVER=127.0.0.1:25565
MINDCRAFT_MC_USERNAME=Mindcraft
# Optional comma-separated bot usernames for a multi-client offline or Microsoft-authenticated swarm.
# If unset, MINDCRAFT_MC_USERNAME is used.
# MINDCRAFT_MC_ACCOUNTS=Mindcraft,Scout,Builder
# In Microsoft mode, usernames should match the Minecraft profiles and match email order below.
MINDCRAFT_MC_AUTH=offline
# Cracked / Offline Mode: no paid bot account required, but the server must allow offline players (online-mode=false).
# This does not bypass authentication on online-mode servers.
# For online-mode servers, set MINDCRAFT_MC_AUTH=microsoft and provide one comma-separated email per bot username.
# One comma-separated email per configured Microsoft bot username (up to 8).
MINDCRAFT_MICROSOFT_EMAIL=
# Only these server-chat usernames may trigger autonomous in-game actions.
# Leave empty to allow chat replies but require dashboard actions for execution.
MINDCRAFT_TRUSTED_PLAYERS=

# AI provider: openai | anthropic | google | ollama | openai-compatible | deepseek | groq | cerebras | mistral | openrouter | xai | grok | qwen | huggingface | hyperbolic | novita | mercury | replicate | lmstudio | vllm | azure
MINDCRAFT_PROVIDER=ollama
MINDCRAFT_MODEL=llama3.1
MINDCRAFT_API_KEY=
# Ollama default:
MINDCRAFT_BASE_URL=http://127.0.0.1:11434/v1
# Azure OpenAI only: MINDCRAFT_MODEL is the deployment name and BASE_URL is the resource endpoint.
MINDCRAFT_AZURE_API_VERSION=2024-10-21

# Dashboard/API. Keep this loopback-only unless you configure a strong token and native TLS.
MINDCRAFT_BIND=127.0.0.1:8787
MINDCRAFT_API_TOKEN=
# For direct non-loopback binds, configure both PEM files; otherwise bind loopback behind a trusted TLS reverse proxy.
# MINDCRAFT_TLS_CERT=/etc/mindcraft/fullchain.pem
# MINDCRAFT_TLS_KEY=/etc/mindcraft/private-key.pem
MINDCRAFT_MODE=balanced
MINDCRAFT_DATABASE=./mindcraft.sqlite3
